<?xml version="1.0" encoding="utf-8"?>
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="YOMA-ControlServer.exe" product-name="YOMA" product-version="${version}" file-version="${version}">
      <authenticode-sign hash-algorithm="sha256" />
    </pe-file>
    <pe-file path="YOMA-Setup-Wizard.exe" product-name="YOMA" product-version="${version}" file-version="${version}">
      <authenticode-sign hash-algorithm="sha256" />
    </pe-file>
    <pe-file path="YOMA-Voice-Agent.exe" product-name="YOMA" product-version="${version}" file-version="${version}">
      <authenticode-sign hash-algorithm="sha256" />
    </pe-file>
  </zip-file>
</artifact-configuration>
